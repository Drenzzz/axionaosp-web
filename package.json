{
  "name": "axionaosp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "astro dev",
    "dev:backend": "cd server && pnpm run dev",
    "build": "astro build && cd server && bun build index.ts --outdir ./build",
    "start": "cd server && cross-env NODE_ENV=production bun run ./build/index.js",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro": "^5.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.544.0",
    "marked": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tsparticles": "^3.9.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/marked": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tw-animate-css": "^1.4.0"
  }
}